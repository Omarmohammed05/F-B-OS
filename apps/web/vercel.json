{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-API-PROJECT.vercel.app/api/:path*"
    },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
